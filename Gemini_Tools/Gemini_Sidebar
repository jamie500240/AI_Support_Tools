javascript:(function(){
  let existing = document.getElementById('gemini-minimap');
  if(existing) existing.remove();

  let container = document.createElement('div');
  container.id = 'gemini-minimap';
  Object.assign(container.style, {
    position: 'fixed', right: '20px', top: '50%', transform: 'translateY(-50%)',
    display: 'flex', flexDirection: 'column', gap: '8px', zIndex: '9999'
  });

  let blocks = document.querySelectorAll('message-content, div[data-message-author]'); 
  if(blocks.length === 0) {
    alert('找不到對話區塊，可能是網頁結構有更新。');
    return;
  }

  blocks.forEach((block) => {
    let line = document.createElement('div');
    Object.assign(line.style, {
      width: '24px', height: '4px', backgroundColor: '#d3d3d3',
      borderRadius: '2px', cursor: 'pointer', transition: 'background-color 0.3s'
    });
    
    /* === 新增：擷取預覽文字 === */
    // 抓取該對話區塊的純文字，並過濾掉多餘的換行與空白
    let text = block.innerText.replace(/\s+/g, ' ').trim();
    // 擷取前 30 個字作為預覽，如果超過就加上刪節號
    line.title = text.length > 30 ? text.substring(0, 30) + '...' : text;
    /* ========================= */

    line.onclick = () => block.scrollIntoView({behavior: 'smooth', block: 'center'});
    
    line.onmouseover = () => line.style.backgroundColor = '#000000';
    line.onmouseout = () => line.style.backgroundColor = '#d3d3d3';
    
    container.appendChild(line);
  });

  document.body.appendChild(container);
})();
